# 本地开发环境变量模板 —— 复制为 .env.local 后填写
#   cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，切勿提交真实密钥。

# 站点地址与端口
# 注意：若宿主机 3000 已被其它服务/Docker 容器占用，这里改成 3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
PORT=3001

# 数据库：postgresql 为完整功能模式（推荐），file 为单机 JSON 模式（商业化接口会返回 501）
VOZEB_PRO_DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://postgres@127.0.0.1:5432/vozeb_pro
VOZEB_PRO_DATABASE_POOL_MAX=10
# 远程数据库需要 SSL 时开启
# VOZEB_PRO_DATABASE_SSL=true

# 服务端敏感配置加密密钥：必须是 64 位十六进制或 32 字节 Base64
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 更换后，库中已加密的渠道凭据/R2 配置将无法解密
VOZEB_PRO_ENCRYPTION_KEY=

# 本地媒体与运行时数据目录（图片/视频/音频落盘位置）
VOZEB_PRO_DATA_DIR=./.data

# 首个管理员初始化用的一次性安装令牌，至少 32 字符
# 使用方式：POST /api/install/initialize  body: {"installToken":"..."}
VOZEB_PRO_INSTALL_TOKEN=

# 本地 http 调试时关闭 Secure Cookie，否则浏览器不保存会话
VOZEB_PRO_COOKIE_SECURE=false
# 本机直连，无反向代理
VOZEB_PRO_TRUSTED_PROXY_HOPS=0

# 生成任务 Worker 令牌（两者必须不同且各 ≥32 字符；留空时 dev 启动脚本会自动生成临时值）
VOZEB_PRO_WORKER_TOKEN=
VOZEB_PRO_MAINTENANCE_TOKEN=
